# /* ---- 💫 https://github.com/0o0-ct/Pixi-Arch-A 💫 ---- */  #
# Hyprlock config for => 8k monitor resolutions                                                         

# Sourcing colors generated by wallust
source = $HOME/.config/hypr/wallust/wallust-hyprland.conf
$Scripts = $HOME/.config/hypr/scripts

general {
    grace = 1
    fractional_scaling = 2
    immediate_render = true
}

background {
    monitor =
    path = $HOME/.config/hypr/wallpaper_effects/.wallpaper_current # current wallpaper
    color = rgb(0,0,0) # color will be rendered initially until path is available

    blur_size = 3
    blur_passes = 2 # 0 disables blurring
    noise = 0.0117
    contrast = 1.3000 # Vibrant!!!
    brightness = 0.8000
    vibrancy = 0.2100
    vibrancy_darkness = 0.0
}


# Date (One UI middle alignment)
label {
    monitor =
    text = cmd[update:43200000] echo "$(date +'%A, %-d %B')"
    color = rgba(255, 255, 255, 0.9)
    font_size = 90
    font_family = Londrina Solid
    position = 0, 270
    halign = center
    valign = center
    shadow_passes = 1
    shadow_size = 3
    shadow_color = rgba(0, 0, 0, 0.25)
}

# Hour-Time (One UI horizontal alignment)
label {
    monitor =
    text = cmd[update:1000] echo "$(date +%I:%M) $(date +%p)" # 12h
    color = rgba(255, 255, 255, 0.95)
    font_size = 450
    font_family = Londrina Outline
    position = 0, 675
    halign = center
    valign = center
    shadow_passes = 1
    shadow_size = 3
    shadow_color = rgba(0, 0, 0, 0.2)
}

# USER
label {
    monitor =
    text =   $USER
    color = $color9
    font_size = 108
    font_family = Victor Mono Bold Oblique
    position = 0, 675
    halign = center
    valign = bottom
}

# INPUT FIELD
input-field {
    monitor =
    size = 675, 195
    outline_thickness = 2
    dots_size = 0.2 # Scale of input-field height, 0.2 - 0.8
    dots_spacing = 0.2 # Scale of dots' absolute size, 0.0 - 1.0
    dots_center = true
    outer_color = $color8
    inner_color = rgba(255, 255, 255, 0.1)
	capslock_color = rgb(255,255,255)
    font_color = $color13
    fade_on_empty = false
    font_family = Victor Mono Bold Oblique
    placeholder_text = <i><span foreground="##ffffff99">🔒 Type Password</span></i>
    hide_input = false
    position = 0, 225
    halign = center
    valign = bottom
}

# Keyboard LAYOUT
label {
    monitor =
    text = $LAYOUT
    color = $color8
    font_size = 42
    font_family = Victor Mono Bold Oblique
    position = 0, 120
    halign = center
    valign = bottom
}

# SYSTEM INFO CARD CONTAINER (Uptime & Battery)
shape {
    monitor =
    size = 800, 280
    color = rgba(15, 20, 30, 0.45) # Glassmorphic background
    rounding = 30
    border_size = 1
    border_color = rgba(255, 255, 255, 0.15) # Subtle glass border
    position = -80, 80
    halign = right
    valign = bottom
}

# UPTIME
label {
    monitor =
    text = cmd[update:60000] echo "<b> "$(uptime -p || $Scripts/UptimeNixOS.sh)" </b>"
    color = rgba(255, 255, 255, 0.8)
    font_size = 28
    font_family = Catchy Mager
    position = -260, 140
    halign = right
    valign = bottom
    text_align = center
}

# BATTERY
label {
    monitor =
    text = cmd[update:1000] echo "<b> "$($Scripts/Battery.sh)" </b>"
    color = rgba(255, 255, 255, 0.8)
    font_size = 28
    font_family = Catchy Mager
    position = -260, 220
    halign = right
    valign = bottom
    text_align = center
}

# WEATHER CARD CONTAINER
shape {
    monitor =
    size = 1400, 450
    color = rgba(15, 20, 30, 0.45) # Glassmorphic background
    rounding = 30
    border_size = 1
    border_color = rgba(255, 255, 255, 0.15) # Subtle glass border
    position = 80, 80
    halign = left
    valign = bottom
}

# WEATHER INFO
label {
    monitor =
    text = cmd[update:3600000] [ -f "$HOME/.cache/.weather_cache" ] && cat  "$HOME/.cache/.weather_cache"
    color = rgba(255, 255, 255, 0.8)
    font_size = 28
    font_family = Catchy Mager
    position = 140, 160
    halign = left
    valign = bottom
}
