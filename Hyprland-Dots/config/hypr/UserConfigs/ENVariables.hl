# /* ---- 💫 https://github.com/0o0-ct/Pixi-Arch-A 💫 ---- */  #
# Environment variables. See https://wiki.hyprland.org/Configuring/Environment-variables/

### Global Universal App Compatibility (Pixi-Arch-A) ###
# Electron & Chromium Apps Auto-Fallback (VS Code, Discord, Arduino, Obsidian, Spotify)
env = ELECTRON_OZONE_PLATFORM_HINT,auto

# GTK Applications (Wayland with X11 fallback)
env = GDK_BACKEND,wayland,x11,*

# Qt Applications (Wayland with XCB fallback)
env = QT_QPA_PLATFORM,wayland;xcb
env = QT_AUTO_SCREEN_SCALE_FACTOR,1
env = QT_WAYLAND_DISABLE_WINDOWDECORATION,1
env = QT_QPA_PLATFORMTHEME,qt6ct

# Java / Swing Applications Fix (Minecraft, JetBrains, NetBeans)
env = _JAVA_AWT_WM_NONREPARENTING,1

# Games & Emulators (SDL Video Driver)
env = SDL_VIDEODRIVER,wayland,x11
env = CLUTTER_BACKEND,wayland

### Aquamarine GPU Routing ###
env = AQ_DRM_DEVICES,/dev/dri/card2:/dev/dri/card1 # Prioritize Intel integrated GPU (card2) as primary for laptop screen and Nvidia (card1) as secondary to eliminate rendering latency
