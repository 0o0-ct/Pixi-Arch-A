# /* ---- 💫 https://github.com/0o0-ct/Pixi-Arch-A 💫 ---- */  #
# For window rules and layerrules
# See https://wiki.hyprland.org/Configuring/Window-Rules/ for more

# --- 💫 Frosted Glassmorphism Layer Rules 💫 ---
layerrule = match:namespace waybar, blur on
layerrule = match:namespace swaync, blur on
layerrule = match:namespace rofi, blur on
layerrule = match:namespace wlogout, blur on
layerrule = match:namespace notifications, blur on
layerrule = match:namespace waybar, ignore_alpha 0.1
layerrule = match:namespace rofi, ignore_alpha 0.1
layerrule = match:namespace swaync, ignore_alpha 0.1
layerrule = match:namespace wlogout, ignore_alpha 0.1
layerrule = match:namespace notifications, ignore_alpha 0.1

# --- 💫 GNOME Files (Nautilus) macOS Tahoe Glass Rules 💫 ---
windowrule = match:class ^(org.gnome.Nautilus)$, float on
windowrule = match:class ^(org.gnome.Nautilus)$, size 1100 700
windowrule = match:class ^(org.gnome.Nautilus)$, center on
windowrule = match:class ^(org.gnome.Nautilus)$, opacity 0.92 0.88
windowrule = match:class ^(org.gnome.Nautilus)$, rounding 16
