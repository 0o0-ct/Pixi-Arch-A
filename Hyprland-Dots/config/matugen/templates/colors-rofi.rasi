/* ---- 💫 https://github.com/0o0-ct/Pixi-Arch-A 💫 ---- */
/* Matugen Material Design 3 template - colors-rofi */

* {
    active-background: {{colors.primary_container.default.hex}};
    active-foreground: {{colors.on_primary_container.default.hex}};
    normal-background: transparent;
    normal-foreground: {{colors.on_surface.default.hex}};
    urgent-background: {{colors.error_container.default.hex}};
    urgent-foreground: {{colors.on_error_container.default.hex}};

    alternate-active-background: transparent;
    alternate-active-foreground: {{colors.on_surface.default.hex}};
    alternate-normal-background: transparent;
    alternate-normal-foreground: {{colors.on_surface.default.hex}};
    alternate-urgent-background: transparent;
    alternate-urgent-foreground: {{colors.on_surface.default.hex}};

    selected-active-background: {{colors.primary.default.hex}};
    selected-active-foreground: {{colors.on_primary.default.hex}};
    selected-normal-background: {{colors.primary.default.hex}};
    selected-normal-foreground: {{colors.on_primary.default.hex}};
    selected-urgent-background: {{colors.error.default.hex}};
    selected-urgent-foreground: {{colors.on_error.default.hex}};

    background-color: rgba({{colors.surface.default.red}}, {{colors.surface.default.green}}, {{colors.surface.default.blue}}, 0.35);
    background: rgba({{colors.surface.default.red}}, {{colors.surface.default.green}}, {{colors.surface.default.blue}}, 0.45);
    foreground: {{colors.on_surface.default.hex}};
    border-color: {{colors.primary.default.hex}};

    color0: {{base16.base00.default.hex}};
    color1: {{base16.base08.default.hex}};
    color2: {{base16.base0b.default.hex}};
    color3: {{base16.base0a.default.hex}};
    color4: {{base16.base0d.default.hex}};
    color5: {{colors.primary.default.hex}};
    color6: {{colors.secondary.default.hex}};
    color7: {{colors.on_surface.default.hex}};
    color8: {{base16.base03.default.hex}};
    color9: {{base16.base09.default.hex}};
    color10: {{colors.tertiary.default.hex}};
    color11: {{colors.primary_container.default.hex}};
    color12: {{colors.secondary_container.default.hex}};
    color13: {{colors.tertiary_container.default.hex}};
    color14: {{colors.primary.default.hex}};
    color15: {{colors.on_primary_container.default.hex}};
}
