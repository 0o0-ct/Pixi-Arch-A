/* ---- 💫 https://github.com/0o0-ct/Pixi-Arch-A 💫 ---- */
/* Main Config (waybar style) */

@import "~/.config/rofi/config.rasi" 

/* ---- Mainbox ---- */
mainbox {
  children: [ "inputbar", "message", "listview"];
}

/* ---- Configuration ---- */
configuration {
  modi: "drun";
}

/* ---- Window ---- */
window {
  width: inherit;
  height: inherit;
}

/* ---- Entry ---- */ 
entry {
  expand: true;
  placeholder: " 🖼️  Buscar / Elegir Estilo Waybar";
}

/* ---- Listview ---- */
listview {
  columns: 2;
  lines: 7;
  fixed-height: false;
  margin: 10px;
  scrollbar: true;
  spacing: 6px;
  cycle: true;
}

/* ---- Elements ---- */
element {
  padding: 8px 12px;
  border-radius: 12px;
  border: 1px;
  border-color: rgba(255, 255, 255, 0.10);
  background-color: rgba(255, 255, 255, 0.05);
}

element normal.normal,
element alternate.normal {
  background-color: rgba(255, 255, 255, 0.05);
}

element selected.normal {
  background-color: @selected;
  border: 1px;
  border-color: rgba(255, 255, 255, 0.45);
  border-radius: 12px;
}

element-icon {
  size: 0%;
}
element-text {
  horizontal-align: 0.0;
  margin: 0px;
  padding: 0px;
}
