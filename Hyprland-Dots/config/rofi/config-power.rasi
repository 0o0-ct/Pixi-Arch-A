/**
 * 💫 Rofi Power Menu Theme (Glassmorphism + Card Layout) 💫
 */

@import "0-shared-fonts.rasi"
@import "config-rofi-theme.rasi"

configuration {
    show-icons: true;
    kb-cancel: "Escape";
}

window {
    transparency: "real";
    location: center;
    anchor: center;
    fullscreen: false;
    width: 762px;
    x-offset: 0px;
    y-offset: 0px;
    enabled: true;
    border-radius: 24px;
    background-color: rgba(255, 255, 255, 0.11);
    border: 1px solid;
    border-color: rgba(255, 255, 255, 0.40);
    cursor: "default";
}

mainbox {
    enabled: true;
    spacing: 0px;
    margin: 0px;
    padding: 30px 35px;
    background-color: transparent;
    children: [ "inputbar", "listview" ];
}

inputbar {
    enabled: true;
    background-color: transparent;
    margin: 0px 0px 30px 0px;
    alignment: center;
    children: [ "dummy", "prompt", "dummy" ];
}

prompt {
    enabled: true;
    font: "FiraCode Nerd Font 28";
    background-color: rgba(255, 255, 255, 0.12);
    text-color: #52adf2; /* Arch blue */
    border: 1px solid;
    border-color: rgba(255, 255, 255, 0.35);
    border-radius: 20px; /* beautiful rounded rectangle card */
    padding: 12px 32px;
    horizontal-align: 0.5;
    vertical-align: 0.5;
}

dummy {
    expand: true;
    background-color: transparent;
}

listview {
    enabled: true;
    columns: 1;
    lines: 6;
    cycle: true;
    dynamic: true;
    scrollbar: false;
    layout: horizontal;
    reverse: false;
    fixed-height: true;
    fixed-columns: true;
    spacing: 16px;
    background-color: transparent;
}

element {
    enabled: true;
    spacing: 12px;
    padding: 24px 5px;
    width: 90px;
    border-radius: 20px;
    background-color: rgba(255, 255, 255, 0.06);
    border: 1px solid;
    border-color: rgba(255, 255, 255, 0.12);
    text-color: @foreground;
    orientation: vertical;
    cursor: pointer;
}

element normal.normal,
element alternate.normal {
    background-color: rgba(255, 255, 255, 0.06);
}

element selected,
element selected.normal {
    background-color: @selected;
    border-color: rgba(255, 255, 255, 0.50);
    text-color: @selected-normal-foreground;
}

element selected element-icon,
element selected.normal element-icon {
    background-color: transparent;
}

element selected element-text,
element selected.normal element-text {
    background-color: transparent;
    text-color: @selected-normal-foreground;
}

element-icon {
    background-color: transparent;
    text-color: inherit;
    size: 40px;
    cursor: inherit;
    horizontal-align: 0.5;
    vertical-align: 0.5;
    x-align: 0.5;
    y-align: 0.5;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    font: "FiraCode Nerd Font 12";
    cursor: inherit;
    horizontal-align: 0.5;
    vertical-align: 0.5;
    x-align: 0.5;
    y-align: 0.5;
    highlight: none;
}

element-text selected {
    background-color: transparent;
    text-color: @color13;
}

element-text selected.normal {
    background-color: transparent;
    text-color: @color13;
}
