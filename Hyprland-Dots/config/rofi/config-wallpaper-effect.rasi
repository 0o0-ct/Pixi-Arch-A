/* ---- 💫 https://github.com/0o0-ct/Pixi-Arch-A 💫 ---- */
/* Wallpaper Effects */

@import "~/.config/rofi/config.rasi" 


/* ---- Mainbox ---- */
mainbox {
  children:
    [ "inputbar", "listview"];
}

/* ---- Entry ---- */ 
entry {
  width: 32%;
  placeholder: " 🏙️ Buscar / Elegir efecto de fondo";
}

/* ---- Window ---- */
window {
  width: inherit;
  height: inherit;
}

/* ---- Listview ---- */
listview {
  columns: 2;
  lines: 7;
  fixed-height: false;
  scrollbar: true;
  spacing: 6px;
  cycle: true;
}

/* ---- Inputbar ---- */
inputbar {
  background-image: url("~/.config/hypr/wallpaper_effects/.wallpaper_modified", width);
}

/* ---- Element ---- */
element {
  padding: 8px 12px;
  border-radius: 12px;
  border: 1px;
  border-color: rgba(255, 255, 255, 0.10);
  background-color: rgba(255, 255, 255, 0.05);
}

element normal.normal,
element alternate.normal {
  background-color: rgba(255, 255, 255, 0.05);
}

element selected.normal {
  background-color: @selected;
  border: 1px;
  border-color: rgba(255, 255, 255, 0.45);
  border-radius: 12px;
}

element-icon {
  size: 0%;
}

element-text {
  horizontal-align: 0.0;
  vertical-align: 0.0;
  margin: 0px;
  padding: 0px;
}