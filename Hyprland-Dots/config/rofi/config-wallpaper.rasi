/* ---- 💫 https://github.com/0o0-ct/Pixi-Arch-A 💫 ---- */
/* Main Config (wallpaper) */

@import "~/.config/rofi/config.rasi"

/* Adaptive glass tokens (smoked / porcelain) from the wallpaper pipeline */
@import "~/.config/rofi/wallust/mode-glass.rasi"  

/* ---- Configuration ---- */ 
configuration {
  modi: "drun";
}

window {
  width: 75%;
  height: inherit;
  border: 1px solid;
  border-radius: 20px;
  border-color: @edge-glass;
  background-color: @pane;
  transparency: "real";
}

/* ---- Mainbox ---- */
mainbox {
  children:
    [ "inputbar", "listview"];
  background-color: transparent;
  padding: 24px;
}

inputbar {
  border: 1px;
  border-radius: 14px;
  border-color: @edge-hi;
  background-color: @lift-hi;
  padding: 10px 16px;
  margin: 0px 0px 14px 0px;
}

entry {
  expand: true;
  placeholder: " 🎞️ Buscar / Elegir Fondo";
  horizontal-align: 0.5;
  background-color: transparent;
}

/* ---- Listview ---- */
listview {
  columns: 6;
  lines: 2;
  spacing: 20px;
  padding: 10px;
  flow: horizontal;
  fixed-width: true;
  fixed-height: true;
  cycle: true;
  background-color: transparent;
}

/* ---- Element ---- */
element {
  orientation: vertical;
  padding: 10px;
  spacing: 6px;
  border-radius: 14px;
  margin: 0px;
  background-color: @element-bg;
  border: 1px;
  border-color: @element-edge;
}

element normal.normal,
element alternate.normal {
  background-color: @element-bg;
}

element selected.normal {
  background-color: @selected;
  border: 1px solid;
  border-color: @selected-edge;
  border-radius: 14px;
}

element-icon {
    text-color:                  inherit;
    size:                        10%;
    margin:                      -30px;
    cursor:                      inherit;
}

element-text {
  vertical-align: 0.5;
  horizontal-align: 0.5;
  padding: 6px;
  margin: 6px;
}