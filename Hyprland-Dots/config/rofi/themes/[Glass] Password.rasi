/* ---- 💫 https://github.com/0o0-ct/Pixi-Arch-A 💫 ---- */
/* Rofi Theme: [Glass] Password Prompt */

@import "[Glass] Monet Frosted.rasi"

window {
    width: 38%;
}

mainbox {
    spacing: 16px;
    padding: 24px;
    children: [ "message", "inputbar" ];
}

custombox {
    enabled: false;
}

listview {
    enabled: false;
}

textbox-prompt-colon {
    str: " 󰌾 ";
}

entry {
    placeholder: "Escribe la contraseña y presiona Enter...";
}
