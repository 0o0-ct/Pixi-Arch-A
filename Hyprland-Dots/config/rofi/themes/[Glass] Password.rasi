/* ---- 💫 https://github.com/0o0-ct/Pixi-Arch-A 💫 ---- */
/* Rofi Theme: [Glass] Password — panel estilo centro de notificaciones (swaync)
   background: alpha(@surface, 0.55) → surface #191114
   border:     1px solid alpha(@color15, 0.20) → color15 #ffd9e4 */

@import "[Glass] Monet Frosted.rasi"

/* ---- Panel (misma receta que .control-center de swaync) ---- */
window {
    width:             42%;
    border:            1px solid;
    border-radius:     16px;
    border-color:      rgba(255, 217, 228, 0.20);
    background-color:  rgba(25, 17, 20, 0.55);
}

mainbox {
    spacing:   14px;
    padding:   24px;
    children:  [ "message", "inputbar" ];
}

custombox {
    enabled: false;
}

listview {
    enabled: false;
}

/* ---- Tarjeta de contexto (como las tarjetas de notificación) ---- */
message {
    enabled:           true;
    margin:            0px;
    padding:           16px 18px;
    border:            1px solid;
    border-radius:     12px;
    border-color:      rgba(255, 217, 228, 0.20);
    background-color:  rgba(38, 29, 32, 0.40);
    text-color:        #eedfe2;
}

/* ---- Campo de contraseña ---- */
textbox {
    padding:           12px 16px;
    border:            1px solid;
    border-radius:     12px;
    border-color:      rgba(255, 217, 228, 0.20);
    background-color:  rgba(38, 29, 32, 0.40);
    text-color:        #eedfe2;
    vertical-align:    0.5;
    highlight:         none;
    placeholder-color: rgba(238, 223, 226, 0.50);
    markup:            true;
}

/* Sin candado suelto: va dentro del placeholder del campo */
textbox-prompt-colon {
    str: " ";
}

entry {
    placeholder: "󰌾  Escribe la contraseña...";
    padding:     6px 10px;
    cursor:      text;
}
