{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "/home/c0o0c/.config/fastfetch/pixi-arch.txt",
        "padding": {
            "top": 1,
            "left": 2
        }
    },
    "display": {
        "separator": " 󰑃  "
    },
    "modules": [
        "break",
        {
            "type": "custom",
            "format": " \u001b[1;38;2;255;255;255m󰣇  𝗣𝗶𝘅𝗶-𝗔𝗿𝗰𝗵-𝗔\u001b[0m"
        },
        {
            "type": "custom",
            "format": " ─+─+─+─+─+─+─+─+─+─+─+─+─+─+─ "
        },
        {
            "type": "os",
            "key": " DISTRO",
            "keyColor": "yellow"
        },
        {
            "type": "kernel",
            "key": "│ ├",
            "keyColor": "yellow"
        },
        {
            "type": "shell",
            "key": "│ └",
            "keyColor": "yellow"
        },
        {
            "type": "wm",
            "key": " DE/WM",
            "keyColor": "blue"
        },
        {
            "type": "terminal",
            "key": "│ └",
            "keyColor": "blue"
        },
        {
            "type": "cpu",
            "key": "󰻠 CPU",
            "keyColor": "green"
        },
        {
            "type": "gpu",
            "key": "│ ├󰢮",
            "keyColor": "green"
        },
        {
            "type": "memory",
            "key": "│ ├󰾆",
            "keyColor": "green"
        },
        {
            "type": "uptime",
            "key": "│ └󰅐",
            "keyColor": "green"
        },
        {
            "type": "custom",
            "format": " ─*─*─*─*─*─*─*─*─*─*─*─*─*─*─ "
        },
        {
            "type": "custom",
            "format": "   \u001b[31m  \u001b[32m  \u001b[33m  \u001b[34m  \u001b[35m  \u001b[36m  \u001b[37m  \u001b[90m "
        },
        "break",
        "break",
        "break",
        "break",
        "break",
        "break"
    ]
}
