[Unit]
Description=Disable CPU Turbo Boost (thermal)
ConditionPathExists=/sys/devices/system/cpu/intel_pstate/no_turbo
After=systemd-modules-load.service

[Service]
Type=oneshot
ExecStart=/usr/bin/env bash -c 'echo 1 > /sys/devices/system/cpu/intel_pstate/no_turbo'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
